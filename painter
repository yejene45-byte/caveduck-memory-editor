                        if (event.key === 'ArrowUp' || event.key === 'ArrowDown') event.preventDefault();
                    });
                    input.addEventListener('blur', () => {
                        const fallback = input.classList.contains('csp-reference-fidelity') ? 0.8 : 0.6;
                        input.value = String(clampNumber(input.value, -1, 1, fallback));
                    });
                });
            });

            container.appendChild(card);

            const nameInput = card.querySelector('.csp-character-name');
            const nameWarning = card.querySelector('.csp-character-name-warning');
            const syncNameWarning = () => {
                const empty = !String(nameInput?.value || '').trim();
                card.classList.toggle('is-missing-name', empty);
                if (nameWarning) nameWarning.style.display = empty ? '' : 'none';
                if (characterToggle) characterToggle.textContent = getCharacterToggleLabel(characterBody?.style.display !== 'none');
            };
            if (nameInput) {
                nameInput.value = getCharacterSlotName(char);
                nameInput.addEventListener('input', syncNameWarning);
            }
            syncNameWarning();

            card.querySelectorAll('.csp-reference-box').forEach((referenceBox, refIndex) => {
                hydrateReferencePreview(referenceBox, references[refIndex]?.assetId || '');
            });
        });
    }

