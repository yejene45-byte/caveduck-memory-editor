    function formatTagbookTagsForFinalPrompt(tags = []) {
        const result = [];
        (Array.isArray(tags) ? tags : []).forEach(tag => {
            const formatted = formatTagbookTagForFinalPrompt(tag);
            if (formatted && !result.includes(formatted)) result.push(formatted);
