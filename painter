            if (strengthInput) strengthInput.value = String(normalized.strength ?? 0.6);
            if (fidelityInput) fidelityInput.value = String(normalized.fidelity ?? 0.8);
            const open = !!(normalized.enabled || normalized.assetId);
            referenceBox.classList.toggle('is-open', open);
            referenceBox.classList.toggle('is-collapsed', !open);
            if (toggleBtn) {
                toggleBtn.textContent = open ? '접기' : '펼치기';
                toggleBtn.setAttribute('aria-expanded', open ? 'true' : 'false');
            }
            hydrateReferencePreview(referenceBox, normalized.assetId || '');
            if (deleteRefBtn) deleteRefBtn.style.display = normalized.assetId ? '' : 'none';
        }

        function loadModeDraft(mode) {
            const profile = normalizePcModeProfile(card.__pcModeProfiles[mode] || {}, 'PC');
            card.__pcEditMode = mode;
            if (nameInput) nameInput.value = profile.name || 'PC';
            if (appearanceInput) appearanceInput.value = profile.appearanceTags || '';
            if (ucInput) ucInput.value = profile.uc || '';
            if (outfitInput) outfitInput.value = profile.outfitTags || '';
            const refs = normalizeCharacterReferences(profile);
            card.querySelectorAll('.csp-reference-box').forEach((referenceBox, refIndex) => {
                applyReferenceStateToBox(referenceBox, refs[refIndex] || createDefaultReferenceSlot());
            });
        }

        function refreshEditModeUi() {
            const selectedMode = normalizePcSlotMode(modeSelect?.value || 'pov');
            loadModeDraft(selectedMode === 'visible' ? 'visible' : 'pov');
        }

        modeSelect?.addEventListener('change', () => {
            collectCurrentModeDraft();
            refreshEditModeUi();
        });

        card.querySelectorAll('.csp-reference-box').forEach((referenceBox, refIndex) => {
            const fileInput = referenceBox.querySelector('.csp-reference-file');
            const assetIdInput = referenceBox.querySelector('.csp-reference-asset-id');
            const imageNameInput = referenceBox.querySelector('.csp-reference-image-name');
            const enabledInput = referenceBox.querySelector('.csp-reference-enabled');
            const deleteRefBtn = referenceBox.querySelector('.csp-reference-delete');
            const toggleBtn = referenceBox.querySelector('.csp-reference-toggle');

            const referenceStateKey = `${getUiScopeId(referenceBox, 'reference')}:pc:ref${refIndex}`;
            const referenceSavedStates = getPersistentUiMap(CSP_ACCORDION_STATE_KEY);

            const setReferenceBoxOpen = (open, persist = false) => {
                referenceBox.classList.toggle('is-open', !!open);
                referenceBox.classList.toggle('is-collapsed', !open);
                if (toggleBtn) {
                    toggleBtn.textContent = open ? '접기' : '펼치기';
                    toggleBtn.setAttribute('aria-expanded', open ? 'true' : 'false');
                }
                if (persist) setPersistentUiMapValue(CSP_ACCORDION_STATE_KEY, referenceStateKey, !!open);
            };

            if (Object.prototype.hasOwnProperty.call(referenceSavedStates, referenceStateKey)) {
                setReferenceBoxOpen(!!referenceSavedStates[referenceStateKey], false);
            }

            toggleBtn?.addEventListener('click', event => {
                event.preventDefault();
                event.stopPropagation();
                setReferenceBoxOpen(!referenceBox.classList.contains('is-open'), true);
            });

            fileInput?.addEventListener('change', async () => {
                const file = fileInput.files?.[0];
                if (!file) return;
                try {
                    let folderHandle = await getStoredDirectoryHandle();
                    if (!folderHandle) {
                        folderHandle = await chooseImageDirectory();
                    } else {
                        const ok = await ensureDirectoryPermission(folderHandle, 'readwrite');
                        if (!ok) throw new Error('저장 폴더 권한이 없어요. 다시 폴더를 연결해줘.');
                    }

                    const oldAssetId = assetIdInput.value;
                    const slotName = card.querySelector('.csp-character-name')?.value.trim() || 'pc';
                    const nextAssetId = await saveReferenceFileToLibrary(file, `${slotName}_${getCurrentEditMode()}_ref${refIndex + 1}`);
                    if (oldAssetId && oldAssetId !== nextAssetId) {
                        try { await deleteReferenceFileFromLibrary(oldAssetId); } catch (_) {}
                    }
                    assetIdInput.value = nextAssetId;
                    imageNameInput.value = file.name || nextAssetId;
                    enabledInput.checked = true;
                    setReferenceBoxOpen(true);
                    await hydrateReferencePreview(referenceBox, nextAssetId);
                    collectCurrentModeDraft();
                    showToast(`🖼️ PC Precise Reference ${refIndex + 1} 이미지를 폴더에 저장했어요.`);
                } catch (err) {
                    showToast('⚠️ Reference 파일 저장 실패: ' + err.message);
                } finally {
                    fileInput.value = '';
                }
            });

            enabledInput?.addEventListener('change', () => {
                hydrateReferencePreview(referenceBox, assetIdInput.value);
                collectCurrentModeDraft();
            });

            deleteRefBtn?.addEventListener('click', async () => {
                const assetId = assetIdInput.value;
                if (assetId) {
                    try { await deleteReferenceFileFromLibrary(assetId); } catch (_) {}
                }
                assetIdInput.value = '';
                imageNameInput.value = '';
                enabledInput.checked = false;
                setReferenceBoxOpen(false);
                await hydrateReferencePreview(referenceBox, '');
                collectCurrentModeDraft();
                showToast(`🧹 PC Precise Reference ${refIndex + 1} 이미지를 폴더에서 삭제했어요.`);
            });

            referenceBox.querySelectorAll('.csp-reference-strength, .csp-reference-fidelity').forEach(input => {
                input.addEventListener('wheel', event => {
                    if (document.activeElement === input) event.preventDefault();
                }, { passive: false });
                input.addEventListener('keydown', event => {
                    if (event.key === 'ArrowUp' || event.key === 'ArrowDown') event.preventDefault();
                });
                input.addEventListener('blur', () => {
                    const fallback = input.classList.contains('csp-reference-fidelity') ? 0.8 : 0.6;
                    input.value = String(clampNumber(input.value, -1, 1, fallback));
                    collectCurrentModeDraft();
                });
                input.addEventListener('change', collectCurrentModeDraft);
            });
            referenceBox.querySelector('.csp-reference-type')?.addEventListener('change', collectCurrentModeDraft);
        });
    }

    function collectPcCharacter(container) {
        const card = container?.querySelector('.csp-character-card');
        if (!card) return createDefaultPcCharacter();
        const modeProfiles = Object.assign({
            pov: createDefaultPcModeProfile(),
            visible: createDefaultPcModeProfile()
        }, card.__pcModeProfiles || {});
        const selectedMode = normalizePcSlotMode(card.querySelector('.csp-pc-mode')?.value || 'pov');
        const editMode = selectedMode === 'visible' ? 'visible' : 'pov';
        const appearanceTags = card.querySelector('.csp-character-appearance')?.value.trim() || '';
        const outfitTags = card.querySelector('.csp-character-outfit')?.value.trim() || '';
        const references = Array.from(card.querySelectorAll('.csp-reference-box')).map(referenceBox => normalizeReferenceSlot({
            enabled: !!referenceBox.querySelector('.csp-reference-enabled')?.checked,
            type: referenceBox.querySelector('.csp-reference-type')?.value || 'character',
            assetId: referenceBox.querySelector('.csp-reference-asset-id')?.value.trim() || '',
            imageName: referenceBox.querySelector('.csp-reference-image-name')?.value.trim() || '',
            strength: referenceBox.querySelector('.csp-reference-strength')?.value,
            fidelity: referenceBox.querySelector('.csp-reference-fidelity')?.value
        }));
        const activeProfile = {
            name: String(card.querySelector('.csp-character-name')?.value || '').trim() || 'PC',
            appearanceTags,
            outfitTags,
            tags: buildCommaPrompt([appearanceTags, outfitTags]),
            uc: card.querySelector('.csp-character-uc')?.value.trim() || ''
        };
        applyLegacyReferenceFields(activeProfile, references);
        modeProfiles[editMode] = normalizePcModeProfile(activeProfile, 'PC');
        const nextPc = {
            enabled: !!card.querySelector('.csp-pc-enabled')?.checked,
            mode: selectedMode,
            modeProfiles: {
                pov: normalizePcModeProfile(modeProfiles.pov, 'PC'),
                visible: normalizePcModeProfile(modeProfiles.visible, 'PC')
            }
        };
        return normalizePcCharacter(nextPc);
    }

    function clearRoomSceneRecords() {
        const records = getSceneRecords();
        Object.values(records || {}).forEach(record => {
            const ids = new Set();
            if (record?.promptArchiveId) ids.add(record.promptArchiveId);
            if (Array.isArray(record?.history)) {
                record.history.forEach(item => {
                    if (item?.promptArchiveId) ids.add(item.promptArchiveId);
                });
            }
            ids.forEach(id => {
                try { promptArchiveMemoryCache.delete(id); } catch (_) {}
                deleteStoredMeta(id).catch(() => {});
            });
        });
        localStorage.removeItem(getSceneRecordsKey());
        invalidateSceneRecordsCache();
        document.querySelectorAll('.csp-generated-scene-image, .csp-image-history-row').forEach(el => el.remove());
        document.querySelectorAll('.csp-message-generate-btn, .csp-message-speed-btn').forEach(btn => btn.removeAttribute('data-csp-has-image'));
        updateGalleryRowCount();
    }

