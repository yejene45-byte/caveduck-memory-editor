    async function showImageRerollSettingsModal(messageKey, box = null, img = null) {
        const records = getSceneRecords();
        const record = records[messageKey];
        if (!record) {
            showToast('⚠️ 수정할 이미지 기록이 없어요.');
            return;
        }

        const existing = document.getElementById('csp-image-reroll-modal');
        if (existing) existing.remove();

        const overlay = document.createElement('div');
        overlay.id = 'csp-image-reroll-modal';
        overlay.className = 'csp-overlay';

        const room = getRoomSettings();
        const promptSource = await resolveGeneratedPromptSnapshot(record, room);
        const settings = Object.assign({}, getDefaultGlobalSettings().naiSettings, getGlobalSettings().naiSettings || {}, promptSource.naiSettings || record.naiSettings || {});
        settings.ucPreset = normalizeNaiUcPresetValue(settings.ucPreset);
