                            try { await deleteReferenceFileFromLibrary(oldAssetId); } catch (_) {}
                        }
                        assetIdInput.value = nextAssetId;
                        imageNameInput.value = file.name || nextAssetId;
                        enabledInput.checked = true;
                        setReferenceBoxOpen(true);
                        await hydrateReferencePreview(referenceBox, nextAssetId);
                        showToast(`🖼️ Precise Reference ${refIndex + 1} 이미지를 폴더에 저장했어요.`);
