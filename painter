            ? Object.entries(diag.sampleRemovedByTopCategory).map(([name, count]) => `${name}: ${count}`).join(' / ')
            : '없음';
        const categoryValues = diag.topCategoryValues?.length
            ? diag.topCategoryValues.map(item => `${item.name}: ${item.count}`).join('\n')
