    function normalizeTagbookSelectorResponse(raw, candidateRows = []) {
        const allowed = new Map();
        (candidateRows || []).forEach(row => {
            const tag = String(row?.tag || '').trim();
            if (tag) allowed.set(normalizeTagbookSelectorTagKey(tag), tag);
        });

        const selectedRaw = parseTagbookSelectorTags(
            raw?.selectedPositive || raw?.selected || raw?.positive || raw?.tags || []
        );
        const selectedPositive = [];
        selectedRaw.forEach(tag => {
            const key = normalizeTagbookSelectorTagKey(tag);
            const allowedTag = allowed.get(key);
            if (allowedTag && !selectedPositive.includes(allowedTag)) selectedPositive.push(allowedTag);
        });

        const rejectedSource = Array.isArray(raw?.rejected) ? raw.rejected : [];
        const rejected = rejectedSource.map(item => {
            if (typeof item === 'string') return { tag: item, reason: '' };
            return {
                tag: String(item?.tag || item?.name || '').trim(),
                reason: String(item?.reason || item?.why || '').trim()
            };
        }).filter(item => item.tag);

        return {
            selectedPositive,
            rejected,
            notes: String(raw?.notes || raw?.note || raw?.reason || '').trim()
        };
    }

