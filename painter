            case 'mood': return '분위기';
            case 'outfit': return '로그 의상';
            case 'context': return '상황';
            default: return '장면';
        }
    }


    function getDanbooruExactTagRow(rowsOrParsed, query) {
        const queryKey = normalizeDanbooruTagKey(query);
        if (!queryKey) return null;

        const parsed = rowsOrParsed && !Array.isArray(rowsOrParsed) ? rowsOrParsed : null;
        const rows = Array.isArray(rowsOrParsed)
            ? rowsOrParsed
            : (Array.isArray(parsed?.rows) ? parsed.rows : []);

        const tagKeyIndex = parsed?.tagKeyIndex && typeof parsed.tagKeyIndex === 'object' ? parsed.tagKeyIndex : null;
        if (tagKeyIndex) {
            // exactTagIndex는 같은 rows를 기준으로 만든 exact 인덱스다.
            // 인덱스에 없으면 선형 스캔으로도 찾을 수 없으므로 바로 null 처리한다.
            const indexed = getDanbooruIndexedRowByKey(rows, tagKeyIndex, queryKey);
            return indexed && looksLikeDanbooruPromptCandidate(indexed) ? indexed : null;
        }

        const tagKeyMap = parsed?.tagKeyMap instanceof Map ? parsed.tagKeyMap : null;
        if (tagKeyMap) {
            // tagKeyMap은 같은 rows를 같은 후보 필터/키 기준으로 만든 exact 인덱스다.
            // Map miss 때 29k rows를 매번 훑던 fallback이 후보 추출 렉의 핵심이라 즉시 null 처리한다.
            const indexed = tagKeyMap.get(queryKey);
            return indexed && looksLikeDanbooruPromptCandidate(indexed) ? indexed : null;
        }

        // 인덱스가 전혀 없는 레거시 배열 직접 호출에서만 최후의 선형 스캔을 유지한다.
        return (rows || []).find(row => looksLikeDanbooruPromptCandidate(row) && normalizeDanbooruTagKey(row.tag) === queryKey) || null;
    }

    function getDanbooruTagTrustLevel(parsed, tag) {
        const key = normalizeDanbooruTagKey(stripScenePromptTagWeight(tag));
        if (key && DANBOORU_VALIDATION_ALLOWED_TAGS.has(key)) {
            return { level: 'trusted', postCount: 0, row: null, allowed: true };
        }

        const row = getDanbooruExactTagRow(parsed, tag);
        if (!row) return { level: 'unknown', postCount: 0, row: null };
        const postCount = Number(row.postCount) || 0;
        return {
            level: postCount >= DANBOORU_TRUSTED_POST_COUNT ? 'trusted' : 'weak',
            postCount,
            row
        };
    }

    function stripScenePromptTagWeight(tag) {
        return String(tag || '')
            .replace(/^\s*-?\d+(?:\.\d+)?::/, '')
            .replace(/::\s*$/, '')
            .trim();
    }

    function validateScenePromptTags(prompt, parsed) {
        const result = { trusted: [], weak: [], unknown: [], total: 0 };
        if (!parsed) return result;
        const seen = new Set();
        splitPromptTokens(prompt || '').forEach(rawTag => {
            const tag = stripScenePromptTagWeight(rawTag);
            if (!tag) return;
            const key = normalizeDanbooruTagKey(tag);
            if (!key || seen.has(key)) return;
            seen.add(key);
            result.total += 1;
            const trust = getDanbooruTagTrustLevel(parsed, tag);
            if (trust.level === 'trusted') result.trusted.push(tag);
            else if (trust.level === 'weak') result.weak.push({ tag, postCount: trust.postCount });
            else result.unknown.push(tag);
        });
        return result;
    }

    function buildScenePromptValidateHtml(validation) {
        if (!validation || !validation.total) {
            return '<span class="csp-tag-validate-empty">검증할 장면 태그가 없어.</span>';
        }
        const lines = [
            `<div class="csp-tag-validate-row">`
            + `<span class="csp-tag-validate-pill is-trusted">✅ ${validation.trusted.length}</span>`
            + `<span class="csp-tag-validate-pill is-weak">⚠️ ${validation.weak.length}</span>`
            + `<span class="csp-tag-validate-pill is-unknown">❌ ${validation.unknown.length}</span>`
            + `</div>`
        ];
        if (validation.weak.length) {
            const weakText = validation.weak
                .map(item => `${escapeHtml(item.tag)} <small>(${Number(item.postCount).toLocaleString()})</small>`)
                .join(', ');
            lines.push(`<div class="csp-tag-validate-detail">⚠️ 약한 태그: ${weakText}</div>`);
        }
        if (validation.unknown.length) {
            lines.push(`<div class="csp-tag-validate-detail">❌ 비표준/미존재: ${validation.unknown.map(escapeHtml).join(', ')}</div>`);
        }
        return lines.join('');
    }

