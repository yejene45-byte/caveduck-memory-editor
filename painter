    function isDanbooruWeakRoleCompatible(row, role = 'scene') {
        const tag = normalizeDanbooruTagKey(row?.tag || '');
        const category = normalizeDanbooruSearchText(row?.category || '');
        const haystack = `${tag} ${category}`;

        if (role === 'composition') {
            return /(from_|view|profile|pov|close|portrait|upper_body|medium|shot|angle|looking)/.test(haystack);
        }
        if (role === 'interaction') {
            return /(smile|eyes|holding|hand|petting|drying|sitting|standing|kneeling|lying|leaning|reaching|hug|kiss|touch|hair|spoon|cup|mug|tentacle|expression|blush|embarrass|amused)/.test(haystack);
        }
        if (role === 'background') {
            return /(indoor|outdoor|room|kitchen|bedroom|bathroom|bed|window|lighting|light|night|day|steam|mug|cup|table|sofa|apartment|city|street|forest|rain|snow|sky)/.test(haystack);
        }
        if (role === 'outfit') {
            return /(shirt|dress|necktie|tie|sleeve|coat|jacket|pants|skirt|uniform|robe|shoes|gloves|hat|hood|collar|vest|suit)/.test(haystack);
        }
        if (role === 'mood') {
            return /(calm|romantic|tense|comedic|humorous|amused|smile|blush|crying|sad|happy|angry|serious|surreal|dramatic)/.test(haystack);
        }
        return true;
    }

    function getDanbooruWeakSuggestionRowsForSource(source, parsed, options = {}) {
        const perSourceLimit = Math.max(1, Math.min(Number(options.perSourceLimit) || 3, 5));
        if (!isDanbooruWeakSuggestionEligible(source)) return [];

        const query = cleanDanbooruCandidateQuery(source.query || '');
        const weakPhraseMap = parsed?.weakPhraseMap instanceof Map ? parsed.weakPhraseMap : null;
        if (!weakPhraseMap) return [];

        const direct = weakPhraseMap.get(normalizeDanbooruSearchText(query)) || [];
        const seen = new Set();
        const rows = [];

        direct.forEach(item => {
            const row = item?.row;
            if (!row?.tag) return;
            if (seen.has(row.tag)) return;
            if (!isDanbooruWeakRoleCompatible(row, source.role || 'scene')) return;
            if (isDanbooruUnsafeExpandedCandidate(row, source)) return;
            seen.add(row.tag);
            rows.push({
                ...row,
                score: Number(item.score || 0) + 420,
                matchType: 'weak',
                trust: 'weak',
                sourceRole: source.role,
                sourceQuery: source.query,
                queries: [source.query],
                weakPhrase: item.phrase || query
            });
        });

        return rows
            .sort((a, b) => (b.score - a.score) || String(a.tag).localeCompare(String(b.tag)))
            .slice(0, perSourceLimit);
    }

    function detectDanbooruCandidateConflicts(rows = []) {
        const tags = new Set((Array.isArray(rows) ? rows : []).map(row => normalizeDanbooruTagKey(row?.tag || '')).filter(Boolean));
        const conflicts = [];
        const pairs = [
            ['day', 'night'],
            ['sunlight', 'night'],
            ['indoors', 'outdoors'],
            ['from_above', 'from_below']
        ];
        pairs.forEach(([a, b]) => {
            if (tags.has(a) && tags.has(b)) conflicts.push(`${a}/${b}`);
        });
        const poseGroup = ['standing', 'sitting', 'lying', 'kneeling'].filter(tag => tags.has(tag));
        if (poseGroup.length >= 3) conflicts.push(poseGroup.join('/'));
        return conflicts;
    }

    function evaluateTagbookSelectionNeed(result = {}) {
        const rows = Array.isArray(result.rows) ? result.rows : [];
        const weakRows = Array.isArray(result.weakRows) ? result.weakRows : [];
        const missed = Array.isArray(result.missedSources) ? result.missedSources : [];
        const conflicts = detectDanbooruCandidateConflicts(rows);
        const expandedCount = rows.filter(row => (row.matchTypes || [row.matchType]).includes('expanded-exact')).length;
        const reasons = [];

        const importantMissed = missed.filter(item => !['mood'].includes(item.role));
        if (weakRows.length) reasons.push(`약한 후보 ${weakRows.length}개`);
        if (importantMissed.length) reasons.push(`못 찾은 seed ${importantMissed.length}개`);
        if (conflicts.length) reasons.push(`충돌 가능성 ${conflicts.join(', ')}`);
        if (expandedCount >= 8) reasons.push('확장 후보 많음');

        if (!reasons.length) {
            return { needApi: false, label: '추천: 후보 전체 추가로 충분해 보여.', reasons: [] };
        }
        return { needApi: true, label: `추천: API로 고르기 권장 · ${reasons.join(' · ')}`, reasons };
    }

    async function searchDanbooruTagbook(query, limit = 40) {
        const tokens = getDanbooruSearchTokens(query);
        if (!tokens.length) return { tokens, rows: [], parsedCount: 0 };
        const parsed = await getParsedDanbooruTagbook();
        const results = [];
        const normalizedQuery = normalizeDanbooruSearchText(query);
        const normalizedLimit = Math.max(1, Math.min(Number(limit) || 40, 100));
        const cacheKey = `${parsed.cacheKey || parsed.updatedAt || 'tagbook'}::${normalizedQuery}::${normalizedLimit}`;
        const cached = danbooruSearchResultCache instanceof Map ? danbooruSearchResultCache.get(cacheKey) : null;
        if (cached) {
            return {
                ...cached,
                rows: (cached.rows || []).map(row => ({ ...row })),
                cacheHit: true
            };
        }

        const minScore = tokens.length === 1 ? 28 : Math.max(24, tokens.length * 12);
        for (const row of parsed.rows) {
            if (row?._isPromptCandidate === false) continue;
            if (!looksLikeDanbooruPromptCandidate(row)) continue;
            if (!isDanbooruRelevantMatch(row, normalizedQuery, tokens, normalizedQuery)) continue;
            const score = scoreDanbooruTagRow(row, normalizedQuery, tokens, normalizedQuery);
            if (score >= minScore) results.push({ ...row, score });
        }
        results.sort((a, b) => b.score - a.score || String(a.tag).localeCompare(String(b.tag)));
        const output = {
            tokens,
            rows: results.slice(0, normalizedLimit),
            parsedCount: parsed.rows.length,
            updatedAt: parsed.updatedAt,
            source: parsed.source,
            cacheHit: false
        };

        if (!(danbooruSearchResultCache instanceof Map)) danbooruSearchResultCache = new Map();
        danbooruSearchResultCache.set(cacheKey, {
            ...output,
            rows: output.rows.map(row => ({ ...row }))
        });
        while (danbooruSearchResultCache.size > 30) {
            const oldest = danbooruSearchResultCache.keys().next().value;
            danbooruSearchResultCache.delete(oldest);
        }

        return output;
    }

    function cleanDanbooruCandidateQuery(value) {
        return normalizeDanbooruSearchText(
            String(value || '')
                .replace(/^\d+(?:\.\d+)?::\s*/, '')
                .replace(/::\s*$/g, '')
                .replace(/[{}\[\]]/g, ' ')
                .replace(/^artist\s*:/i, '')
        );
    }

    function normalizeDanbooruTagKey(value) {
        return cleanDanbooruCandidateQuery(value)
            .replace(/\s+/g, '_')
            .replace(/_+/g, '_')
            .replace(/^_|_$/g, '');
    }

    function addDanbooruCandidateSource(list, value, role = 'scene') {
        const cleaned = cleanDanbooruCandidateQuery(value);
        if (!cleaned || cleaned.length < 2 || cleaned.length > 80) return;

        const blocked = new Set([
            'solo', '1girl', '1boy', '2girls', '2boys', 'multiple girls', 'multiple boys',
            'masterpiece', 'best quality', 'amazing quality', 'very aesthetic', 'absurdres',
            'highres', '4k', 'official art', 'illustration'
        ]);
        if (blocked.has(cleaned)) return;

        const key = `${role}::${cleaned}`;
        if (list.some(item => item.key === key)) return;
        list.push({
            key,
            role,
            query: cleaned,
            original: String(value || '').trim()
        });
    }

    function splitPromptToDanbooruCandidateSources(source, role, list) {
        String(source || '')
            .split(',')
            .map(part => part.trim())
            .filter(Boolean)
            .forEach(part => addDanbooruCandidateSource(list, part, role));
    }

    function buildDanbooruCandidateSourcesFromPlan(plan = {}) {
        const sources = [];
        const context = plan.globalContext || {};

        splitPromptToDanbooruCandidateSources(plan.composition, 'composition', sources);
        splitPromptToDanbooruCandidateSources(plan.interactionPrompt, 'interaction', sources);
        splitPromptToDanbooruCandidateSources(plan.baseScenePrompt, 'background', sources);
        splitPromptToDanbooruCandidateSources(plan.mood, 'mood', sources);
        splitPromptToDanbooruCandidateSources(plan.temporaryOutfitPrompt, 'outfit', sources);
        splitPromptToDanbooruCandidateSources(context.locationPrompt, 'background', sources);
        splitPromptToDanbooruCandidateSources(context.timePrompt, 'background', sources);
        splitPromptToDanbooruCandidateSources(context.atmospherePrompt, 'mood', sources);

        // scenePrompt는 위 필드가 비어 있을 때의 안전망. 역할은 scene으로만 둔다.
        if (!sources.length) splitPromptToDanbooruCandidateSources(plan.scenePrompt, 'scene', sources);

        // 한국어 상황 요약은 최후의 안전망으로만 사용한다.
        // 장면/의상 태그가 이미 있으면 "잡다/손/침대/장난" 같은 한국어 단어 검색이
        // ankle_grab, grabbing_from_behind, at_gunpoint처럼 과한 후보를 끌어올 수 있어서 제외한다.
        if (!sources.length) {
            String(context.situationSummary || '')
                .split(/[\s,，、/|.。!！?？]+/)
                .map(part => part.trim())
                .filter(part => /[가-힣]/.test(part))
                .filter(part => part.length >= 2)
                .slice(0, 6)
                .forEach(part => addDanbooruCandidateSource(sources, part, 'context'));
        }

        return sources.slice(0, 24);
    }

    function getDanbooruCandidateRoleLabel(role) {
        switch (role) {
            case 'composition': return '구도';
            case 'interaction': return '행동/표정';
