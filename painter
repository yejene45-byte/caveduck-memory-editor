                contents: [
                    {
                        role: 'user',
                        parts: [{ text: prompt }]
                    }
                ],
                generationConfig: buildGeminiGenerationConfig(geminiRequest.model, {
                    temperature: 0.15,
                    topP: 0.7,
                    responseMimeType: 'application/json'
                })
            };

            try {
                const data = await requestGeminiGenerateContent(geminiRequest, payload);
                const responseText = (data.candidates || [])
                    .flatMap(candidate => candidate.content?.parts || [])
                    .map(part => part.text || '')
                    .join('\n')
                    .trim();
                if (!responseText) throw new Error('빈 응답');
                const rawJson = extractJsonLoose(responseText);
                const normalized = normalizeTagbookSelectorResponse(rawJson, lastTagbookApiCandidateRows);
                lastTagbookSelectedPositive = normalized.selectedPositive || [];
                tagbookCandidateResultEl.innerHTML = previousHtml + buildTagbookSelectorResultHtml(normalized);
                updateTagbookRecommendedApplyButton();
                showToast(`✅ API 선택 완료: ${lastTagbookSelectedPositive.length}개`);
                return true;
            } catch (err) {
                console.error('[Crack Scene Painter] Tagbook API selector failed:', err);
                tagbookCandidateResultEl.innerHTML = previousHtml + `<div class="csp-mini-note csp-storage-top">API 선택 실패: ${escapeHtml(err.message || err)}</div>`;
                showToast('⚠️ API 선택 실패: ' + (err.message || err));
                return false;
            }
        }

        function getLastTagbookCandidateTags() {
            return (lastTagbookCandidateRows || [])
                .map(row => row?.tag || '')
                .map(tag => String(tag).trim())
                .filter(Boolean);
        }

        function normalizeFinalPromptTagForCompare(value) {
            return normalizeDanbooruFinalTagCompare(value);
        }

        function getTagbookRowsBySelectedTags(selectedTags = []) {
            const allowed = new Map();
            (lastTagbookApiCandidateRows || []).forEach(row => {
                const tag = String(row?.tag || '').trim();
                if (tag && !allowed.has(normalizeTagbookSelectorTagKey(tag))) allowed.set(normalizeTagbookSelectorTagKey(tag), row);
            });
            return (selectedTags || [])
                .map(tag => allowed.get(normalizeTagbookSelectorTagKey(tag)) || { tag })
                .filter(row => row?.tag);
        }

        function getTagbookReplacementPairsForRows(rows = []) {
            const pairs = [];
            (Array.isArray(rows) ? rows : []).forEach(row => {
                const to = formatTagbookTagForFinalPrompt(row?.tag || '');
                const originalQuery = String(row?.sourceQuery || row?.queries?.[0] || '').trim();
                const from = formatTagbookTagForFinalPrompt(originalQuery);
                if (!from || !to) return;
                if (normalizeFinalPromptTagForCompare(from) === normalizeFinalPromptTagForCompare(to)) return;
                const matchTypes = Array.isArray(row.matchTypes) ? row.matchTypes : [row.matchType || ''];
                // exact는 사실상 1=1 확인용이다. 실제 교체는 expanded/weak/API 선택 후보만 기록한다.
                if (matchTypes.includes('exact') && !matchTypes.includes('expanded-exact') && !matchTypes.includes('weak')) return;
                if (pairs.some(item => normalizeFinalPromptTagForCompare(item.from) === normalizeFinalPromptTagForCompare(from) && normalizeFinalPromptTagForCompare(item.to) === normalizeFinalPromptTagForCompare(to))) return;
                pairs.push({ from, to, matchTypes: matchTypes.filter(Boolean) });
            });
            return pairs;
        }

        function replacePromptTagsByCanonicalPairs(prompt, pairs = []) {
            if (!pairs.length) return { text: prompt, replaced: [] };
            const replacements = new Map();
            pairs.forEach(pair => {
                const fromKey = normalizeFinalPromptTagForCompare(pair.from);
                const toKey = normalizeFinalPromptTagForCompare(pair.to);
                if (fromKey && toKey && fromKey !== toKey && !replacements.has(fromKey)) {
                    replacements.set(fromKey, pair);
                }
            });
            if (!replacements.size) return { text: prompt, replaced: [] };

            const replaced = [];
            const kept = String(prompt || '')
                .split(',')
                .map(part => part.trim())
                .filter(Boolean)
                .filter(part => {
                    const key = normalizeFinalPromptTagForCompare(part);
                    const pair = replacements.get(key);
                    if (!pair) return true;
                    replaced.push(pair);
                    return false;
                });

            return { text: kept.join(', '), replaced };
        }

        function renderTagbookFinalApplyNote(label, tags = [], replacements = [], stats = {}) {
            if (!tagbookCandidateResultEl) return;
            tagbookCandidateResultEl.querySelectorAll('.csp-tagbook-final-apply-note').forEach(el => el.remove());
            const shown = (tags || []).slice(0, 24);
            const chips = shown.map(tag => `<span class="csp-tagbook-selected-chip">${escapeHtml(tag)}</span>`).join('');
            const more = tags.length > shown.length
                ? `<span class="csp-mini-note">외 ${escapeHtml(String(tags.length - shown.length))}개</span>`
                : '';

            const replacementRows = (replacements || []).slice(0, 12).map(pair => `
                <div class="csp-tagbook-rejected-row">
                    <code>${escapeHtml(pair.from)}</code>
                    <span>→</span>
                    <code>${escapeHtml(pair.to)}</code>
                </div>
            `).join('');

            const effectiveCount = Number(stats.newCount || 0) + Number(stats.replacementCount || 0);
            const replacementHtml = replacements?.length
                ? `<details class="csp-inline-details csp-storage-top" open>
                    <summary>실제 치환 ${escapeHtml(String(replacements.length))}개</summary>
                    ${replacementRows}
                </details>`
                : `<div class="csp-mini-note csp-storage-top">실제 치환 0개${effectiveCount ? ' · 이번 적용은 신규 추가/중복 정리 중심이야.' : ' · 변경 없음.'}</div>`;

            const statLine = [
                `신규 ${Number(stats.newCount || 0)}개`,
                `중복 ${Number(stats.duplicateCount || 0)}개`,
                `치환 ${Number(stats.replacementCount || 0)}개`
            ].join(' · ');

            const title = effectiveCount
                ? `적용 결과 · ${escapeHtml(label)} · Final Prompt 반영됨 ${escapeHtml(String(tags.length))}개`
                : `변경 없음 · ${escapeHtml(label)} ${escapeHtml(String(tags.length))}개는 이미 Final에 있음`;

            const footnote = effectiveCount
                ? 'Final Base Prompt에 바로 반영했어. 중복 태그는 자동 정리돼.'
                : '새로 넣을 태그나 치환할 seed가 없어서 Final Prompt는 그대로 뒀어.';

            tagbookCandidateResultEl.insertAdjacentHTML('beforeend', `
                <div class="csp-tagbook-selector-block csp-tagbook-final-apply-note csp-storage-top">
                    <div class="csp-tagbook-selector-title">${title}</div>
                    <div class="csp-mini-note">이번 적용: ${escapeHtml(statLine)}</div>
                    <div class="csp-tagbook-selected-list">${chips}${more}</div>
                    ${replacementHtml}
                    <div class="csp-mini-note csp-storage-top">${escapeHtml(footnote)}</div>
                </div>
            `);
        }

        function appendTagbookRowsToFinalPrompt(rows = [], label = '태그북 후보') {
            const tags = formatTagbookTagsForFinalPrompt((rows || []).map(row => row?.tag || row).filter(Boolean));
            if (!tags.length) {
                showToast(`적용할 ${label}가 없어.`);
                return { count: 0, replacements: [], stats: { newCount: 0, duplicateCount: 0, replacementCount: 0 } };
            }

            const beforeValue = finalPromptEl.value;
            const beforeKeys = new Set(
                String(beforeValue || '')
                    .split(',')
                    .map(part => normalizeFinalPromptTagForCompare(part))
                    .filter(Boolean)
            );
            const replacementPairs = getTagbookReplacementPairsForRows(rows);
            const replacedResult = replacePromptTagsByCanonicalPairs(beforeValue, replacementPairs);
            const newCount = tags.filter(tag => !beforeKeys.has(normalizeFinalPromptTagForCompare(tag))).length;
            const duplicateCount = Math.max(0, tags.length - newCount);
            const stats = {
                newCount,
                duplicateCount,
                replacementCount: replacedResult.replaced.length
            };

            const effectiveCount = Number(stats.newCount || 0) + Number(stats.replacementCount || 0);
            if (effectiveCount > 0) {
                const nextValue = dedupePromptString(buildCommaPrompt([
                    replacedResult.text,
                    tags.join(', ')
                ]));
                finalPromptEl.value = nextValue;
                finalPromptDirty = true;

                // 일부 브라우저/모바일/확프 조합에서 JS value 대입만으로 UI 보조 갱신이 늦는 경우가 있어 input/change를 명시 발생시킨다.
                finalPromptEl.dispatchEvent(new Event('input', { bubbles: true }));
                finalPromptEl.dispatchEvent(new Event('change', { bubbles: true }));

                updatePromptDedupePreview(finalPromptDedupeEl, finalPromptEl.value);

                try {
                    finalPromptEl.scrollTop = finalPromptEl.scrollHeight;
                    const end = finalPromptEl.value.length;
                    finalPromptEl.setSelectionRange(end, end);
                } catch (_) {}
            } else {
                updatePromptDedupePreview(finalPromptDedupeEl, finalPromptEl.value);
            }

            renderTagbookFinalApplyNote(label, tags, replacedResult.replaced, stats);
            updateTagbookRecommendedApplyButton();

            return { count: tags.length, replacements: replacedResult.replaced, stats, effectiveCount };
        }

        function getRowsForTagbookApplyMode(mode) {
            if (mode === 'selected') return getTagbookRowsBySelectedTags(lastTagbookSelectedPositive || []);
            if (mode === 'replacement') return lastTagbookReplacementRows || [];
            if (mode === 'all') return lastTagbookCandidateRows || [];
            return [];
        }

        function getRawTagsForTagbookApplyMode(mode) {
            if (mode === 'selected') return lastTagbookSelectedPositive || [];
            return getRowsForTagbookApplyMode(mode).map(row => row?.tag || row).filter(Boolean);
        }

        function getTagbookApplyStats(rows = [], rawTags = []) {
            const sourceTags = rawTags?.length ? rawTags : (rows || []).map(row => row?.tag || row).filter(Boolean);
            const tags = formatTagbookTagsForFinalPrompt(sourceTags);
            const finalKeys = new Set(
                String(finalPromptEl?.value || '')
                    .split(',')
                    .map(part => normalizeFinalPromptTagForCompare(part))
                    .filter(Boolean)
            );
            const newCount = tags.filter(tag => !finalKeys.has(normalizeFinalPromptTagForCompare(tag))).length;
            const duplicateCount = Math.max(0, tags.length - newCount);
            const replacementPairs = getTagbookReplacementPairsForRows(rows);
            const replaceResult = replacePromptTagsByCanonicalPairs(finalPromptEl?.value || '', replacementPairs);
            return {
                total: tags.length,
                newCount,
                duplicateCount,
                replacementCount: replaceResult.replaced.length
            };
        }

        function formatTagbookApplyStatsText(stats = {}) {
            return `신규 ${Number(stats.newCount || 0)} · 중복 ${Number(stats.duplicateCount || 0)} · 치환 ${Number(stats.replacementCount || 0)}`;
        }

        function getTagbookRecommendedApplyMode() {
            if ((lastTagbookSelectedPositive || []).length) {
                const rows = getRowsForTagbookApplyMode('selected');
                const stats = getTagbookApplyStats(rows, getRawTagsForTagbookApplyMode('selected'));
                return {
                    mode: 'selected',
                    label: `추천 반영: API 선택 ${lastTagbookSelectedPositive.length}개`,
                    summary: `현재 추천: API 선택 ${lastTagbookSelectedPositive.length}개 · ${formatTagbookApplyStatsText(stats)}`,
                    stats,
                    enabled: true
                };
            }
            if ((lastTagbookReplacementRows || []).length) {
                const rows = getRowsForTagbookApplyMode('replacement');
                const stats = getTagbookApplyStats(rows, getRawTagsForTagbookApplyMode('replacement'));
                return {
                    mode: 'replacement',
                    label: `추천 반영: 치환 후보 ${lastTagbookReplacementRows.length}개`,
                    summary: `현재 추천: 치환 후보 ${lastTagbookReplacementRows.length}개 · ${formatTagbookApplyStatsText(stats)}`,
                    stats,
                    enabled: true
                };
            }
            if ((lastTagbookCandidateRows || []).length) {
                const rows = getRowsForTagbookApplyMode('all');
                const stats = getTagbookApplyStats(rows, getRawTagsForTagbookApplyMode('all'));
                return {
                    mode: 'all',
                    label: `추천 반영: 후보 전체 ${lastTagbookCandidateRows.length}개`,
                    summary: `현재 추천: 후보 전체 ${lastTagbookCandidateRows.length}개 · ${formatTagbookApplyStatsText(stats)}`,
                    stats,
                    enabled: true
                };
            }
            return {
                mode: 'none',
                label: '추천대로 Final 반영',
                summary: '후보 추출 후 추천 반영 방식이 여기에 표시돼.',
                stats: { total: 0, newCount: 0, duplicateCount: 0, replacementCount: 0 },
                enabled: false
            };
        }

        function updateTagbookRecommendedApplyButton() {
            const info = getTagbookRecommendedApplyMode();
            if (tagbookRecommendedApplyBtn) {
                // 버튼은 길어지면 모바일/좁은 화면에서 잘려서, 짧은 액션명만 유지한다.
                tagbookRecommendedApplyBtn.textContent = info.label;
                tagbookRecommendedApplyBtn.disabled = !info.enabled;
                tagbookRecommendedApplyBtn.title = info.enabled
                    ? `${info.summary} / 현재 상태 기준으로 가장 안전한 방식으로 Final Prompt에 반영`
                    : '후보 추출 후 사용할 수 있어';
            }
            if (tagbookApplySummaryEl) {
                tagbookApplySummaryEl.textContent = info.summary;
            }
        }

        function applyRecommendedTagbookTagsToFinalPrompt() {
            const info = getTagbookRecommendedApplyMode();
            if (info.mode === 'selected') {
                applySelectedTagbookTagsToFinalPrompt();
                return;
            }
            if (info.mode === 'replacement') {
                applyTagbookReplacementTagsToFinalPrompt();
                return;
            }
            if (info.mode === 'all') {
                applyTagbookCandidatesToFinalPrompt();
                return;
            }
            showToast('먼저 단부루 후보를 추출해줘.');
        }

        async function ensureTagbookCandidatesReady() {
            if (!lastTagbookCandidateRows.length && !lastTagbookReplacementRows.length && !lastTagbookSelectedPositive.length) {
                await refreshTagbookCandidatePreview();
            }
            return !!(lastTagbookCandidateRows.length || lastTagbookReplacementRows.length || lastTagbookSelectedPositive.length);
        }

        async function applyTagbookCanonicalRowsToScenePrompt() {
            if (!scenePromptEl) return;
            await ensureTagbookCandidatesReady();
            const rows = lastTagbookReplacementRows || [];
            if (!rows.length) {
                showToast('보정할 장면태그가 없어. 이번 후보는 대부분 동일 확인 태그야.');
                return;
            }

            const tags = formatTagbookTagsForFinalPrompt(rows.map(row => row?.tag || '').filter(Boolean));
            const replacementPairs = getTagbookReplacementPairsForRows(rows);
            const replacedResult = replacePromptTagsByCanonicalPairs(scenePromptEl.value, replacementPairs);
            const nextScenePrompt = dedupePromptString(buildCommaPrompt([
                replacedResult.text,
                tags.join(', ')
            ]));

            if (normalizeFinalPromptTagForCompare(nextScenePrompt) === normalizeFinalPromptTagForCompare(scenePromptEl.value)) {
                showToast('장면태그 보정 결과가 기존과 같아.');
                return;
            }

            scenePromptEl.value = nextScenePrompt;
            currentPlan.scenePrompt = nextScenePrompt;
            promptState.scenePrompt = nextScenePrompt;
            finalPromptDirty = false;
            recomputeFinalPrompt({ preserveFinalPrompt: false, preserveFinalNegative: finalNegativeDirty });
            renderTagbookFinalApplyNote('장면태그 보정', tags, replacedResult.replaced, {
                newCount: tags.length,
                duplicateCount: 0,
                replacementCount: replacedResult.replaced.length
            });
            showToast(`✅ 장면태그 ${tags.length}개를 단부루 후보로 보정했어.`);
        }

        async function applyTagbookAutoBoostBeforeGenerate() {
            // 단부루 태그북은 NAI 생성 전 확인창에서 검색용으로만 사용한다.
            // Final Prompt 자동 보정/후보 반영은 더 이상 수행하지 않는다.
            return;
        }

        function applyTagbookReplacementTagsToFinalPrompt() {
            const rows = lastTagbookReplacementRows || [];
            if (!rows.length) {
                showToast('치환할 태그북 후보가 없어. 이번 후보는 대부분 동일 확인 태그야.');
                return;
            }
            const result = appendTagbookRowsToFinalPrompt(rows, '치환 후보');
            if (!result.count) return;
            const suffix = ` · 신규 ${result.stats.newCount} / 중복 ${result.stats.duplicateCount} / 치환 ${result.stats.replacementCount}`;
            if (!result.effectiveCount) {
                showToast(`ℹ️ 치환 후보 ${result.count}개는 이미 반영돼 있어.${suffix}`);
                return;
            }
            showToast(`✅ 치환 후보 ${result.count}개를 Final Prompt에 반영했어.${suffix}`);
        }

        function applyTagbookCandidatesToFinalPrompt() {
            const result = appendTagbookRowsToFinalPrompt(lastTagbookCandidateRows || [], '태그북 후보');
            if (!result.count) return;
            const suffix = ` · 신규 ${result.stats.newCount} / 중복 ${result.stats.duplicateCount} / 치환 ${result.stats.replacementCount}`;
            if (!result.effectiveCount) {
                showToast(`ℹ️ 태그북 후보 ${result.count}개는 이미 반영돼 있어.${suffix}`);
                return;
            }
            showToast(`✅ 태그북 후보 ${result.count}개를 Final Prompt에 반영했어.${suffix}`);
        }

        function applySelectedTagbookTagsToFinalPrompt() {
            if (!(lastTagbookSelectedPositive || []).length) {
                showToast('적용할 API 선택 태그가 없어. 먼저 [API로 고르기]를 눌러줘.');
                return;
            }
            const selectedRows = getTagbookRowsBySelectedTags(lastTagbookSelectedPositive || []);
            const result = appendTagbookRowsToFinalPrompt(selectedRows, 'API 선택 태그');
            if (!result.count) return;
            const suffix = ` · 신규 ${result.stats.newCount} / 중복 ${result.stats.duplicateCount} / 치환 ${result.stats.replacementCount}`;
            if (!result.effectiveCount) {
                showToast(`ℹ️ API 선택 태그 ${result.count}개는 이미 반영돼 있어.${suffix}`);
                return;
            }
            showToast(`✅ API 선택 태그 ${result.count}개를 Final Prompt에 반영했어.${suffix}`);
        }

