    function getPersistentUiMap(key) {
        try {
            const value = JSON.parse(localStorage.getItem(key) || '{}');
            return value && typeof value === 'object' ? value : {};
        } catch (_) {
            return {};
        }
    }

    function setPersistentUiMapValue(key, itemKey, value) {
        try {
            const map = getPersistentUiMap(key);
            map[itemKey] = value;
            localStorage.setItem(key, JSON.stringify(map));
        } catch (err) {
            console.warn('[Crack Scene Painter] UI state save failed:', err);
        }
    }

    function getUiScopeId(root, suffix = '') {
        const source = root instanceof Element ? root : null;
        const modal = source?.closest?.('.csp-overlay') || source?.querySelector?.('.csp-overlay') || root;
        const modalId = modal?.id || source?.id || 'csp-modal';

        const ownPanel = source?.matches?.('[data-csp-tab-panel]')
            ? source
            : source?.closest?.('[data-csp-tab-panel]');
        const childPanel = !ownPanel && source?.querySelector?.('[data-csp-tab-panel]')
            ? source.querySelector('[data-csp-tab-panel]')
            : null;
        const panelName = (ownPanel || childPanel)?.getAttribute?.('data-csp-tab-panel') || '';

        return [modalId, panelName, suffix].filter(Boolean).join(':');
    }

    function getTextareaStateId(textarea, root) {
        if (!textarea) return '';

        const panel = textarea.closest?.('[data-csp-tab-panel]');
        const scopeBase = panel ? getUiScopeId(panel) : getUiScopeId(textarea.closest?.('.csp-overlay') || root);

        if (textarea.id) return `${scopeBase}:#${textarea.id}`;

        const card = textarea.closest?.('[data-index], [data-ref-index]');
        const cardKey = card
            ? `${Array.from(card.classList || []).filter(cls => /^csp-/.test(cls)).slice(0, 2).join('.') || 'card'}:${card.getAttribute('data-index') ?? card.getAttribute('data-ref-index') ?? ''}`
            : '';

        const classKey = Array.from(textarea.classList || [])
            .filter(cls => /^csp-/.test(cls))
            .slice(0, 3)
            .join('.');

        const siblings = panel || root || document;
        const index = Array.from(siblings.querySelectorAll('textarea')).indexOf(textarea);
        return `${scopeBase}:${cardKey}:${classKey || 'textarea'}:${index}`;
    }

    function restorePersistentTextareas(root) {
        if (!root) return;
        const heights = getPersistentUiMap(CSP_TEXTAREA_HEIGHTS_KEY);
        const observers = [];
        const saveTimers = new WeakMap();
        const restoredAt = Date.now();

        root.querySelectorAll('textarea').forEach(textarea => {
            if (textarea.dataset.cspHeightBound === 'true') return;
            textarea.dataset.cspHeightBound = 'true';

            const key = getTextareaStateId(textarea, root);
            textarea.dataset.cspHeightKey = key;

            const savedHeight = Number(heights[key]);
            if (Number.isFinite(savedHeight) && savedHeight >= 48 && savedHeight <= 1200) {
                textarea.style.height = `${savedHeight}px`;
            }

            const saveHeight = (force = false) => {
                if (!force && Date.now() - restoredAt < 500) return;
                if (!textarea.isConnected) return;
                const rect = textarea.getBoundingClientRect();
                if (!rect.width || !rect.height) return;
                const height = Math.round(rect.height || textarea.offsetHeight || 0);
                if (!height || height < 48 || height > 1200) return;
                setPersistentUiMapValue(CSP_TEXTAREA_HEIGHTS_KEY, key, height);
            };

            const scheduleSave = (force = false) => {
                clearTimeout(saveTimers.get(textarea));
                const timer = setTimeout(() => saveHeight(force), 140);
                saveTimers.set(textarea, timer);
            };

            textarea.addEventListener('mouseup', () => scheduleSave(true));
            textarea.addEventListener('touchend', () => scheduleSave(true), { passive: true });
            textarea.addEventListener('blur', () => saveHeight(true));
            textarea.addEventListener('input', () => scheduleSave(false));

            if (typeof ResizeObserver === 'function') {
                const ro = new ResizeObserver(() => scheduleSave(false));
                ro.observe(textarea);
                observers.push(ro);
            }
        });

        root.__cspTextareaResizeObservers = observers;
    }

    function makeSectionsCollapsible(root, openTitlePatterns = []) {
        if (!root) return;
        const patterns = (openTitlePatterns || []).map(item => item instanceof RegExp ? item : new RegExp(String(item), 'i'));
        const savedStates = getPersistentUiMap(CSP_ACCORDION_STATE_KEY);

        root.querySelectorAll('.csp-section').forEach((section, index) => {
            if (section.dataset.cspCollapsible === 'true') return;
            const titleEl = section.querySelector(':scope > .csp-section-title');
            if (!titleEl) return;

            const title = titleEl.textContent.trim();
            const body = document.createElement('div');
            body.className = 'csp-section-body';
            Array.from(section.childNodes).forEach(node => {
                if (node !== titleEl) body.appendChild(node);
            });

            const button = document.createElement('button');
            button.type = 'button';
            button.className = 'csp-section-toggle';
            button.innerHTML = `<span class="csp-section-arrow">▶</span><span>${escapeHtml(title)}</span>`;
            section.insertBefore(button, section.firstChild);
            section.appendChild(body);
            titleEl.remove();
            section.dataset.cspCollapsible = 'true';

            const stateKey = `${getUiScopeId(section)}:${title}:${index}`;
            const fallbackOpen = patterns.length
                ? patterns.some(pattern => pattern.test(title))
                : index === 0;
            const savedOpen = Object.prototype.hasOwnProperty.call(savedStates, stateKey)
                ? !!savedStates[stateKey]
                : fallbackOpen;

            const setOpen = (open, persist = false) => {
                section.classList.toggle('is-open', open);
                body.hidden = !open;
                const arrow = button.querySelector('.csp-section-arrow');
                if (arrow) arrow.textContent = open ? '▼' : '▶';
                button.setAttribute('aria-expanded', open ? 'true' : 'false');
                if (persist) setPersistentUiMapValue(CSP_ACCORDION_STATE_KEY, stateKey, !!open);
            };

            button.addEventListener('click', () => setOpen(!section.classList.contains('is-open'), true));
            setOpen(savedOpen, false);
        });
    }


