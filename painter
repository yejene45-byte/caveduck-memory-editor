            const safeTab = ['api', 'characters', 'prompts', 'advanced', 'usage'].includes(tabName) ? tabName : 'api';
            tabButtons.forEach((item) => {
                const active = item.dataset.cspTab === safeTab;
                item.classList.toggle('is-active', active);
                item.setAttribute('aria-selected', active ? 'true' : 'false');
            });
            tabPanels.forEach((panel) => {
                panel.classList.toggle('is-active', panel.dataset.cspTabPanel === safeTab);
            });
            overlay.querySelector('.csp-modal')?.scrollTo({ top: 0, behavior: 'auto' });
            try { localStorage.setItem(SETTINGS_LAST_TAB_KEY, safeTab); } catch (_) {}
        }
        tabButtons.forEach((button) => {
            button.addEventListener('click', () => activateSettingsTab(button.dataset.cspTab));
