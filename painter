                slotName: name,
                characterNames: characters.map(getCharacterSlotName)
            });
            const existingIndex = quickCharacterSlots.findIndex(slot => String(slot.name || '').trim() === name);
            if (existingIndex >= 0) quickCharacterSlots[existingIndex] = nextSlot;
