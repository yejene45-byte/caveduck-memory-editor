        function applyScenePromptCorrections(prompt, corrections) {
            const map = new Map();
            (corrections || []).forEach(c => {
                const fromKey = normalizeDanbooruTagKey(c.from);
                if (fromKey && !map.has(fromKey)) map.set(fromKey, c);
            });
            if (!map.size) return { text: prompt, changed: [] };
            const changed = [];
            const out = [];
            splitPromptTokens(prompt || '').forEach(rawTag => {
                const tag = String(rawTag || '').trim();
                if (!tag) return;
                const key = normalizeDanbooruTagKey(stripScenePromptTagWeight(tag));
                const c = map.get(key);
                if (!c) { out.push(tag); return; }
                const to = formatTagbookTagForFinalPrompt(c.to || '');
                if (to) { out.push(to); changed.push({ from: c.from, to }); }
                else { changed.push({ from: c.from, to: '' }); }
            });
            return { text: dedupePromptString(out.join(', ')), changed };
        }

        async function buildScenePromptCorrectionPrompt(unknownTags) {
            const items = [];
            for (const tag of unknownTags) {
                let candidates = [];
                try {
                    const res = await searchDanbooruTagbook(tag, 6);
                    candidates = (res.rows || []).slice(0, 6).map(r => r.tag);
                } catch (_) {}
                items.push({ tag, candidates });
            }
            return `너는 NovelAI/Danbooru 태그 교정기다.
아래 태그들은 로컬 Danbooru 태그북에 정확히 존재하지 않는(비표준) 장면 태그다.
각 태그를 실제로 존재하고 자주 쓰이는 표준 Danbooru 태그로 교정한다.

[규칙]
- 같은 뜻의 가장 흔한 표준 Danbooru 태그 1개로 바꾼다. 소문자, 띄어쓰기.
- candidates에 적절한 게 있으면 그 안에서 고른다. 없으면 네가 아는 표준 태그를 쓴다.
- 마땅한 표준 태그가 없으면 "to"를 빈 문자열로 둬서 버린다.
- 새 의미를 지어내지 않는다. 원래 태그의 뜻을 최대한 유지한다.
- 캐릭터명/작가명/작품명/메타/NSFW로 바꾸지 않는다.

[교정 대상]
${JSON.stringify(items, null, 2)}

[응답 형식]
반드시 JSON만 출력한다.
{
  "corrections": [
    {"from": "원래태그", "to": "표준태그_또는_빈문자열"}
  ]
}`;
        }

        async function runScenePromptAutoCorrect({ silent = false } = {}) {
            if (!scenePromptEl) return false;
            let parsed;
            try { parsed = await getParsedDanbooruTagbook(); }
            catch (_) { if (!silent) showToast('태그북이 없어 교정을 건너뛰었어.'); return false; }

            const validation = validateScenePromptTags(scenePromptEl.value, parsed);
            if (!validation.unknown.length) {
                if (!silent) showToast('교정할 비표준(❌) 태그가 없어.');
                return false;
            }

            const global = getGlobalSettings();
            const geminiRequest = getGeminiGenerateContentRequestConfig(global, { silent: true });
            if (!geminiRequest) {
                if (!silent) showToast('Gemini/API 설정이 없어 교정을 못 했어.');
                return false;
            }

            const prompt = await buildScenePromptCorrectionPrompt(validation.unknown);
            const payload = {
                contents: [{ role: 'user', parts: [{ text: prompt }] }],
                generationConfig: buildGeminiGenerationConfig(geminiRequest.model, {
                    temperature: 0.1,
                    topP: 0.7,
                    responseMimeType: 'application/json'
                })
            };

            try {
                const data = await requestGeminiGenerateContent(geminiRequest, payload);
                const responseText = (data.candidates || [])
                    .flatMap(c => c.content?.parts || [])
                    .map(p => p.text || '').join('\n').trim();
                if (!responseText) throw new Error('빈 응답');
                const rawJson = extractJsonLoose(responseText);
                const rawCorrections = Array.isArray(rawJson?.corrections) ? rawJson.corrections : [];

                const unknownKeySet = new Set(validation.unknown.map(t => normalizeDanbooruTagKey(t)));
                const corrections = [];
                rawCorrections.forEach(item => {
                    const from = String(item?.from || '').trim();
                    const fromKey = normalizeDanbooruTagKey(from);
                    if (!from || !unknownKeySet.has(fromKey)) return;
                    let to = String(item?.to || '').trim();
                    if (to && !getDanbooruExactTagRow(parsed, to)) to = ''; // 태그북에 없으면 버림
                    corrections.push({ from, to });
                });

                if (!corrections.length) {
                    if (!silent) showToast('교정 결과가 없어. 비표준 태그를 그대로 둘게.');
                    return false;
                }

                const applied = applyScenePromptCorrections(scenePromptEl.value, corrections);
                if (normalizeFinalPromptTagForCompare(applied.text) === normalizeFinalPromptTagForCompare(scenePromptEl.value)) {
                    if (!silent) showToast('교정 후 변화가 없어.');
                    return false;
                }

                scenePromptEl.value = applied.text;
                currentPlan.scenePrompt = applied.text;
                promptState.scenePrompt = applied.text;

                // 3b 수동/추가 교정이 들어간 경우에도 왼쪽 태그 요약이 옛 태그를 다시 뱉지 않도록
                // plan의 각 요약 필드까지 같은 교정표로 동기화한다.
                ['composition', 'interactionPrompt', 'baseScenePrompt', 'mood', 'temporaryOutfitPrompt'].forEach(key => {
                    if (!currentPlan[key]) return;
                    currentPlan[key] = applyScenePromptCorrections(currentPlan[key], corrections).text;
                });
                if (tempOutfitPromptEl) tempOutfitPromptEl.value = currentPlan.temporaryOutfitPrompt || '';
                renderSceneSummaryTexts();

                recomputeFinalPrompt({ preserveFinalPrompt: finalPromptDirty, preserveFinalNegative: finalNegativeDirty, preserveCharacterPrompts: characterPromptDirty });

                const fixed = applied.changed.filter(c => c.to).length;
                const dropped = applied.changed.filter(c => !c.to).length;
                const parts = [];
                if (fixed) parts.push(`교정 ${fixed}`);
                if (dropped) parts.push(`제거 ${dropped}`);
                showToast(`✅ ❌ 태그 ${parts.join(' / ') || applied.changed.length}개 처리했어.`);
                return true;
            } catch (err) {
                console.error('[Crack Scene Painter] scene prompt auto correct failed:', err);
                if (!silent) showToast('⚠️ 태그 교정 실패: ' + (err.message || err));
                return false;
            }
        }

