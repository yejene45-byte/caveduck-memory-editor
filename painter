            ['rolled up sleeves'].forEach(add);
        }
        if (key.includes('button_up_shirt') || key.includes('button-down_shirt') || key.includes('button_down_shirt')) {
            ['dress shirt'].forEach(add);
        }

        // 역할별 약한 보정. 너무 넓게 넣지 않는다.
        if (role === 'background' && key === 'soft') {
            ['soft lighting'].forEach(add);
        }
        if (role === 'background' && key === 'warm') {
            ['dim lighting'].forEach(add);
        }
        if (role === 'mood' && (key.includes('peaceful') || key.includes('relaxed') || key.includes('reassuring'))) {
            ['calm'].forEach(add);
        }

        return result.slice(0, 6);
    }

    function isDanbooruUnsafeExpandedCandidate(row, source) {
        const tag = String(row?.tag || '').toLowerCase();
        const role = source?.role || 'scene';
        const sourceKey = normalizeDanbooruTagKey(source?.query || '');

        // exact는 위에서 따로 처리하므로 여기서는 확장/검색 후보만 보수적으로 거른다.
        if (!tag) return true;
        if (/[()]/.test(tag)) return true;
        if (tag.includes('artist') || tag.includes('copyright')) return true;

        if (sourceKey === 'pov' && tag !== 'pov') return true;
        if (sourceKey === 'portrait' && tag !== 'portrait') return true;
        if (sourceKey === 'day' && tag !== 'day') return true;
        if (sourceKey === 'calm' && tag !== 'calm') return true;
        if (tag.includes('meme')) return true;

        const blockedExactTags = new Set([
            'homework',
            'homeless',
            'homeworld_gem_uniform',
            'emotional_engine_-_full_drive',
            'muji_body_fitting_sofa',
            'inconspicuous_sex_toy',
            'against_mirror',
            'age_comparison',
            'anal_grip',
            'battoujutsu_stance',
            'drawing_sword',
            'florist',
            'gingham_background',
            'clothes_on_floor',
            'candelabra_(object)',
            'anvil_position',
            'bed_invitation'
        ]);
        if (blockedExactTags.has(tag)) return true;
        if (/sex_toy|handcuff|anal|nsfw/.test(tag)) return true;
        if (!shouldAllowDanbooruContextTag(tag, source)) return true;

        // 역할이 구도인데 신체 부위 특화 POV가 섞이면 오염 가능성이 높다.
        if (role === 'composition' && /^pov_/.test(tag)) return true;

        return false;
    }

    async function getDanbooruCandidateRowsForSource(source, parsed, options = {}) {
        const perSourceLimit = Math.max(1, Math.min(Number(options.perSourceLimit) || 5, 12));
        const rows = [];

        const exact = getDanbooruExactTagRow(parsed, source.query);
        if (exact) {
            rows.push({
                ...exact,
                score: 9999,
                matchType: 'exact',
                sourceRole: source.role,
                sourceQuery: source.query,
                queries: [source.query]
            });
            return rows;
        }

        // exact가 없을 때만 통제된 확장을 한다. 예: gentle smile → light smile/slight smile/smile.
        const expansionQueries = getDanbooruControlledExpansionQueries(source.query, source.role);
        for (const expansionQuery of expansionQueries) {
            const expansionExact = getDanbooruExactTagRow(parsed, expansionQuery);
            if (expansionExact) {
                rows.push({
                    ...expansionExact,
                    score: 7000,
                    matchType: 'expanded-exact',
                    sourceRole: source.role,
                    sourceQuery: source.query,
                    queries: [source.query, expansionQuery]
                });
            }
        }

        if (rows.length) return rows.slice(0, perSourceLimit);

        // 영어 장면 태그는 문자열 검색 fallback을 쓰지 않는다.
        // home -> homework, holding hand -> holding_handcuffs처럼 잡음이 너무 쉽게 섞이기 때문.
        // 한국어 힌트만 좁은 검색 fallback을 허용한다.
        if (!/[가-힣]/.test(source.query)) return [];

        const result = await searchDanbooruTagbook(source.query, Math.min(perSourceLimit, 4));
        return (result.rows || [])
            .filter(row => !isDanbooruUnsafeExpandedCandidate(row, source))
            .slice(0, perSourceLimit)
            .map(row => ({
                ...row,
                matchType: 'search',
                sourceRole: source.role,
                sourceQuery: source.query,
                queries: [source.query]
            }));
    }

    async function collectDanbooruScenePromptCandidates(plan = {}, options = {}) {
        const limit = Math.max(1, Math.min(Number(options.limit) || 24, 80));
        const perSourceLimit = Math.max(1, Math.min(Number(options.perSourceLimit) || 5, 12));
        const sources = buildDanbooruCandidateSourcesFromPlan(plan);
        if (!sources.length) return { sources, queries: [], rows: [], groupedRows: {}, parsedCount: 0 };

        const parsed = await getParsedDanbooruTagbook();
        const sourceCacheKey = getDanbooruCandidateSourceCacheKey(sources, limit, perSourceLimit);
        const cacheKey = `${parsed.cacheKey || ''}::${sourceCacheKey}`;
        if (danbooruCandidateResultCache?.cacheKey === cacheKey) {
            return Object.assign(cloneDanbooruCandidateResult(danbooruCandidateResultCache.result), { cacheHit: true });
        }

        const byTag = new Map();
        const weakByTag = new Map();
        const missedSources = [];

        for (const source of sources) {
            const sourceRows = await getDanbooruCandidateRowsForSource(source, parsed, { perSourceLimit });
            if (!sourceRows.length) {
                const weakRows = getDanbooruWeakSuggestionRowsForSource(source, parsed, { perSourceLimit: 3 });
                if (!weakRows.length) {
                    missedSources.push({
                        role: source.role || 'scene',
                        query: source.query || '',
                        original: source.original || source.query || ''
                    });
                } else {
                    weakRows.forEach(row => {
                        if (!row?.tag) return;
                        const key = String(row.tag).toLowerCase();
                        const prev = weakByTag.get(key) || {
                            ...row,
                            score: 0,
                            hits: 0,
                            roles: [],
                            queries: [],
                            matchTypes: []
                        };
                        prev.score += Number(row.score || 0);
                        prev.hits += 1;
                        if (!prev.roles.includes(source.role)) prev.roles.push(source.role);
                        (row.queries || [source.query]).forEach(query => {
                            if (query && !prev.queries.includes(query)) prev.queries.push(query);
                        });
                        if (row.matchType && !prev.matchTypes.includes(row.matchType)) prev.matchTypes.push(row.matchType);
                        weakByTag.set(key, prev);
                    });
                }
            }
            sourceRows.forEach(row => {
                if (!row?.tag) return;
                const key = String(row.tag).toLowerCase();
                const prev = byTag.get(key) || {
                    ...row,
                    score: 0,
                    hits: 0,
                    roles: [],
                    queries: [],
                    matchTypes: []
                };
                prev.score += Number(row.score || 0);
                prev.hits += 1;
                if (!prev.roles.includes(source.role)) prev.roles.push(source.role);
                (row.queries || [source.query]).forEach(query => {
                    if (query && !prev.queries.includes(query)) prev.queries.push(query);
                });
                if (row.matchType && !prev.matchTypes.includes(row.matchType)) prev.matchTypes.push(row.matchType);
                byTag.set(key, prev);
            });
        }

        const rows = Array.from(byTag.values())
            .sort((a, b) => {
                const exactA = a.matchTypes?.includes('exact') ? 1 : 0;
                const exactB = b.matchTypes?.includes('exact') ? 1 : 0;
                if (exactA !== exactB) return exactB - exactA;
                return (b.hits - a.hits) || (b.score - a.score) || String(a.tag).localeCompare(String(b.tag));
            })
            .slice(0, limit);

        const weakRows = Array.from(weakByTag.values())
            .filter(row => !byTag.has(String(row.tag || '').toLowerCase()))
            .sort((a, b) => (b.hits - a.hits) || (b.score - a.score) || String(a.tag).localeCompare(String(b.tag)))
            .slice(0, Math.min(16, limit));

        const groupedRows = rows.reduce((acc, row) => {
            const role = row.roles?.[0] || row.sourceRole || 'scene';
            if (!acc[role]) acc[role] = [];
            acc[role].push(row);
            return acc;
        }, {});

        const groupedWeakRows = weakRows.reduce((acc, row) => {
            const role = row.roles?.[0] || row.sourceRole || 'scene';
            if (!acc[role]) acc[role] = [];
            acc[role].push(row);
            return acc;
        }, {});

        const result = {
            sources,
            queries: sources.map(source => source.query),
            rows,
            groupedRows,
            weakRows,
            groupedWeakRows,
            missedSources,
            parsedCount: parsed.rows.length
        };
        result.apiRecommendation = evaluateTagbookSelectionNeed(result);
        danbooruCandidateResultCache = {
            cacheKey,
            result: cloneDanbooruCandidateResult(result)
        };
        return result;
    }

    function parseTagbookSelectorTags(value) {
        if (Array.isArray(value)) return value.map(tag => String(tag || '').trim()).filter(Boolean);
        return String(value || '')
